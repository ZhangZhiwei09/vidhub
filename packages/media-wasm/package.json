{
  "name": "@vidhub/media-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./pkg/vidhub_media_wasm.d.ts",
      "default": "./pkg/vidhub_media_wasm.js"
    }
  },
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg --release --no-pack",
    "postbuild": "node -e \"require('node:fs').rmSync('pkg/.gitignore', { force: true })\"",
    "clean": "node -e \"require('node:fs').rmSync('pkg', { recursive: true, force: true })\""
  }
}
